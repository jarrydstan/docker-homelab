# Throwaway values used by CI to render and smoke-test the stack.
# @ROOT@ is replaced with a scratch directory; nothing here is a real secret.
HOSTNAME=the-fellowship
DOCKERDIR=@ROOT@
APPDIR=@ROOT@/appdata
DATADIR=@ROOT@/data
PUID=1000
PGID=1000
TZ=Australia/Melbourne
LTIME=/etc/localtime:/etc/localtime:ro
DOMAINNAME_NA=example.com
DOMAINNAME_J=example.org
ADMIN_EMAIL=ci@example.com
CROWDSEC_PROMETHEUS_EXPORT=6060
CROWDSEC_COLLECTIONS=crowdsecurity/linux
CROWDSEC_BOUNCER_TRAEFIK_API_KEY=ci-bouncer-key
DOZZLE_REMOTE_HOST=tcp://socket-proxy:2375
MINDWTR_CLOUD_AUTH_TOKENS=ci-token-0123456789abcdefghij
PAPERLESS_SECRET_KEY=ci-secret-key-0123456789abcdefghijklmnopqrstuvwxyz
PAPERLESS_PG_USER=paperless
PAPERLESS_PG_DB=paperless
PAPERLESS_PG_PASS=paperless
PAPERLESS_URL=http://localhost:8000
PAPERLESS_APPS=
PAPERLESS_SOCIALACCOUNT_PROVIDERS={}
